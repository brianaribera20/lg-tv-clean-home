# Copy to tv.local.env (not committed) and fill in both values for your TV.
# TV_HOST: the address shown in the TV's Developer Mode app, e.g. 192.168.1.50.
# TV_APP_TITLE: the name webOS shows on Home's "Loading..." card, e.g. "Welcome, <your name>".
#               Left blank, the card just says "Home".
TV_HOST=
TV_APP_TITLE=""
# TV_WEATHER_LAT / TV_WEATHER_LON: your location for the weather in the header (leave blank to hide it).
TV_WEATHER_LAT=
TV_WEATHER_LON=
